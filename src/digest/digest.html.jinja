<span style="{{EMAIL_INLINE_CSS_STYLE}}">

<div style="font-size: 28px; font-weight: bold; margin-bottom: 10px;">Today's News Digest</div>
<div style="font-size: 18px; margin-bottom: 20px;">{{ today_date }}</div>

{% set section_style = "font-size: 26px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; color: #222; border-bottom: 2px solid #444; padding-bottom: 4px; margin-top: 30px; margin-bottom: 10px;" %}
{% set kind_colors = {'NEW': '#2e7d32', 'CHANGED': '#ef6c00', 'CONFIRMED': '#1565c0', 'CONTRADICTED': '#c62828'} %}

{% if alert_updates %}
<div style="{{ section_style }}">News</div>

{% for update in alert_updates %}
<div style="font-size: 24px; font-weight: bold; margin-top: 25px; margin-bottom: 15px;">
    {{ update.topic }}
</div>

{# With several facts, lead with the overview; with one, the fact says it all #}
{% if update.developments|length > 1 and update.summary %}
<div style="margin-bottom: 10px;">{{ update.summary }}</div>
{% endif %}

<ul style="margin-top: 5px; padding-left: 20px;">
    {% for dev in update.developments %}
    <li style="margin-bottom: 15px;">
        <div>
            <span style="font-size: 12px; font-weight: bold; color: #fff; background: {{ kind_colors[dev.kind] }}; padding: 1px 5px; border-radius: 3px;">{{ dev.kind }}</span>
            {% if dev.status == 'RUMOR' %}<span style="font-size: 12px; color: #888; font-style: italic;">rumor</span>{% endif %}
            {{ dev.statement }}
        </div>
        {% if dev.sources %}
        <ul style="margin-top: 6px; padding-left: 20px; list-style-type: circle;">
            {% for source in dev.sources %}
            <li style="margin-bottom: 8px;">
                <div style="font-size: 14px;">
                    <a href="{{ source.url }}">{{ source.title }}</a>
                    <span style="color: #888;">[{{ source.url.split('//')[1].split('/')[0] }}]</span>
                </div>
                {% if source.highlight %}
                <div style="margin-top: 2px; color: #555; font-size: 14px;">{{ source.highlight }}</div>
                {% endif %}
            </li>
            {% endfor %}
        </ul>
        {% endif %}
    </li>
    {% endfor %}
</ul>

{% if not loop.last %}
<hr style="border: 0; height: 1px; background: #ddd; margin: 20px 0;">
{% endif %}
{% endfor %}
{% endif %}

{% if newsletter %}
<div style="{{ section_style }}">Articles</div>

{% for category, content in newsletter.categorized_content.items() %}
<div style="font-size: 24px; font-weight: bold; margin-top: 25px; margin-bottom: 15px;">
    {{ category }}
</div>

<div style="margin-bottom: 15px;">{{ content.summary }}</div>

{% if content.notable_aspects %}
<div style="margin-bottom: 15px;"><b>Notable Aspects:</b> {{ content.notable_aspects }}</div>
{% endif %}

{% if content.sources|length == 1 %}
<div style="margin-bottom: 10px;">
  <b>Source:</b>
  <a href="{{ content.sources[0].url }}">{{ content.sources[0].title }}</a>
  <span style="color: #888; font-size: 14px;">[{{ content.sources[0].url.split('//')[1].split('/')[0] }}]</span>
</div>
{% else %}
<div style="margin-bottom: 10px;"><b>Sources:</b></div>
<ul style="margin-top: 5px; padding-left: 20px;">
    {% for source in content.sources %}
    <li style="margin-bottom: 12px;">
        <div>
            <a href="{{ source.url }}">{{ source.title }}</a>
            <span style="color: #888; font-size: 14px;">[{{ source.url.split('//')[1].split('/')[0] }}]</span>
        </div>
        {% if not content.is_single_article %}
        <div style="margin-top: 3px; color: #555; font-size: 14px;">{{ source.highlight }}</div>
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endif %}

{% if not loop.last %}
<hr style="border: 0; height: 1px; background: #ddd; margin: 20px 0;">
{% endif %}
{% endfor %}
{% endif %}

<div style="margin-top: 30px; color: #777; font-style: italic;">
    This newsletter is curated based on your interests. All information is current as of {{ today_date }}.
</div>

</span>
